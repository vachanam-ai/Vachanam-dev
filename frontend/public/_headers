# Keep search engines OFF the raw Cloudflare Pages URLs (#359): old
# *.pages.dev deployment snapshots stay reachable forever and were feeding
# scrapers stale pricing. Only vachanam.in should be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Self-hosted fonts — long cache (stable filenames, versioned by content).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Vite content-hashes every compiled asset. Let repeat visits use the local
# copy without a validation round-trip; a changed build gets a new filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public filenames are stable rather than hashed, so keep a short freshness
# window and serve stale while Cloudflare checks for a newer deployment.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/voices/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/vachanam-mark.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
